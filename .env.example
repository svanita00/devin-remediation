# Copy to .env and adjust. Everything works in mock mode with these defaults.

# --- Devin API (v3) ---
# mock = no API calls, no cost (default). live = real calls to api.devin.ai/v3.
DEVIN_MODE=mock
# Required only when DEVIN_MODE=live. Your Devin PAT (cog_...).
DEVIN_API_KEY=
DEVIN_ORG_ID=org-810cadad51d945e3a673b97d53289387
DEVIN_API_BASE=https://api.devin.ai/v3

# --- Target + remediation policy ---
TARGET_REPO=svanita00/superset
SCAN_TYPE=security
REMEDIATE_SEVERITIES=critical,high
MAX_REMEDIATIONS_PER_RUN=3
AUTO_REVIEW=true

# --- Polling ---
POLL_INTERVAL_SECONDS=10
SCAN_POLL_TIMEOUT_SECONDS=3600

# --- Reporting (labeled estimates for the ROI view) ---
HOURS_SAVED_PER_FIX=2
MANUAL_BASELINE_DAYS=14

# --- Mock tuning (ignored when live) ---
MOCK_SECONDS_TO_COMPLETE=6
MOCK_NUM_FINDINGS=4
